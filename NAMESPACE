export(dea, dea_sbm, dea_ddf, dea_add, dea_rts, dea_rts_test, dea_boot,
       dea_sim, dea_rate,
       dea_panel, dea_malmquist, dea_wr, dea_cone, dea_reg, dea_undesirable,
       dea_mult, dea_categorical, dea_nd,
       wr_bound, wr_ratio, wr_linear,
       dea_cost, dea_revenue, dea_profit, dea_cross,
       efficiency, peers, slacks, multipliers)

import("lpSolveAPI")

## nobs() and fitted() are stats generics. Registering an S3 method for a
## generic the namespace cannot see fails at LOAD time, not at call time, with
## "object 'nobs' not found whilst loading namespace" -- so the package
## installs cleanly and then refuses to load.
importFrom("stats", "IQR", "bw.SJ", "bw.nrd0", "bw.ucv", "coef", "dnorm",
                    "fitted", "lm.fit", "model.matrix", "nobs", "optim",
                    "pnorm", "qnorm", "quantile", "rexp", "rnorm",
                    "runif", "sd", "terms")
importFrom("graphics", "abline", "hist", "legend", "lines", "par",
                      "points", "segments")
importFrom("utils", "flush.console", "head")

S3method(print,   dea)
S3method(summary, dea)
S3method(plot,    dea)
S3method(fitted,  dea)
S3method(nobs,    dea)
S3method(efficiency, dea)
S3method(peers,      dea)
S3method(slacks,     dea)

S3method(multipliers, dea)

S3method(print,      dea_price)
S3method(summary,    dea_price)
S3method(efficiency, dea_price)
S3method(fitted,     dea_price)
S3method(peers,      dea_price)
S3method(nobs,       dea_price)

S3method(print,       dea_cross)
S3method(summary,     dea_cross)
S3method(efficiency,  dea_cross)
S3method(multipliers, dea_cross)
S3method(nobs,        dea_cross)

S3method(print, dea_restriction)
S3method(c,     dea_restriction)

S3method(print,   dea_nd)

S3method(print,   dea_categorical)
S3method(summary, dea_categorical)

S3method(print,   dea_mult)
S3method(summary, dea_mult)

S3method(print,   dea_undesirable)

S3method(print,   dea_wr)
S3method(peers,   dea_wr)
S3method(slacks,  dea_wr)

S3method(print,   dea_reg)
S3method(summary, dea_reg)
S3method(nobs,    dea_reg)
S3method(coef,    dea_reg)

S3method(print,   dea_panel)
S3method(summary, dea_panel)
S3method(nobs,    dea_panel)

S3method(print,   dea_malmquist)
S3method(summary, dea_malmquist)
S3method(nobs,    dea_malmquist)

S3method(print,   dea_rts)
S3method(summary, dea_rts)
S3method(print,   dea_rts_test)
S3method(summary, dea_rts_test)
S3method(nobs,    dea_rts_test)
S3method(print,   dea_boot)
S3method(summary, dea_boot)
S3method(print,   dea_sim)

S3method(plot,    dea_boot)
S3method(plot,    dea_rts)
S3method(plot,    dea_cross)
S3method(plot,    dea_price)
S3method(plot,    dea_sim)
